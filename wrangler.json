{
  "name": "open-up",
  "keep_vars": true,
  "compatibility_date": "2026-10-16",
  "compatibility_flags": ["nodejs_compat"],
  "main": "dist/server/index.mjs",
  "no_bundle": true,
  "rules": [{ "type": "ESModule", "globs": ["**/*.mjs", "**/*.js"] }],
  "assets": { "binding": "ASSETS", "directory": "dist/client" }
}
